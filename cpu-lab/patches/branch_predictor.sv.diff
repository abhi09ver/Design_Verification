     function [2:0] plru_update(input [2:0] old, input logic [1:0] way);
         plru_update = old;
         case (way)
-            2'd0: plru_update = {old[2], old[1], 1'b0}; // left-left
-            2'd1: plru_update = {old[2], old[1], 1'b1}; // left-right
-            2'd2: plru_update = {old[2], 1'b0, old[0]}; // right-left
