+  // fields) took about 70% of instructions. Pick the opcode class first, by weight.
+  int unsigned w_r = 20, w_i = 20, w_ld = 15, w_st = 15, w_br = 10,
+               w_lui = 5, w_auipc = 5, w_jal = 5, w_jalr = 5;
+
+  function void pre_randomize();
+    opcode.rand_mode(1);
+    randcase
+      w_r     : opcode = R_TYPE;
